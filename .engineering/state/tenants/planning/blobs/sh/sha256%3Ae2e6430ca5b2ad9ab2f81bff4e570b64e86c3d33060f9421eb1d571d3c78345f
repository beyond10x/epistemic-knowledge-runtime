status":"archived","title":"Both resolve functions return a node whatever their marker parameter says"},"lifecycle_state":"archived"},"relations":[{"serves":"vision:o2"}],"title":"Both resolve functions return a node whatever their marker parameter says"},"id":"ent-78ef8c6641ce490a6d72753e6cee877b","lifecycle_state":"archived","revision":3,"version":1},"order":"per_kind_only","subject":["task","ent-78ef8c6641ce490a6d72753e6cee877b"]}]